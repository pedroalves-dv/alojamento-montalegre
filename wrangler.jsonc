// Cloudflare Workers, static assets only: no Worker code, no Astro adapter.
// Having this file also stops `wrangler deploy` from auto-configuring the
// project (which would add @astrojs/cloudflare and switch to on-demand rendering).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alojamento-montalegre",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status
    "not_found_handling": "404-page"
  },
  // No per-version preview addresses: they would be extra crawlable copies of the site
  "preview_urls": false,
  // The real domain (DNS record and certificate are managed by Cloudflare). www is not listed:
  // a Redirect Rule on the zone sends it here with a 301.
  "routes": [{ "pattern": "alojamentomontalegre.com", "custom_domain": true }],
  // Off: the custom domain is the only address, so search engines never see
  // a second copy of the site on *.workers.dev
  "workers_dev": false
}
