---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FAQ from "@/components/home/FAQ.astro";
import Icon from "@/components/ui/Icon.astro";
import { config } from "@/config";
import { properties } from "@/data/properties";
import { faq } from "@/data/faq";
import { seo } from "@/data/seo";
import { localeParams, useTranslations, type Locale } from "@/i18n";
import { telHref, whatsappHref } from "@/lib/links";
import { breadcrumbs, faqPage } from "@/lib/schema";

export const getStaticPaths = localeParams;

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale, "Contacto");
const tNav = useTranslations(locale, "Nav");
---

<BaseLayout
  locale={locale}
  title={seo.contacto.title[locale]}
  description={seo.contacto.description[locale]}
  path="/contacto"
  ogImage="contacto"
  jsonLd={[breadcrumbs(locale, [{ name: tNav("contacto"), path: "/contacto" }]), faqPage(faq, locale)]}
>
  <section class="container-site pt-12 md:pt-20">
    <h1 class="heading-1 text-granite">{t("heading")}</h1>
    <p class="mt-4 text-lg text-muted">{t("subheading")}</p>
    <span class="mt-5 inline-flex items-center gap-2 rounded-full bg-forest/10 px-4 py-1.5 text-sm font-medium text-forest">
      <Icon name="clock" size={14} />
      {t("responseNote")}
    </span>
  </section>

  <section class="container-site py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        properties.map((p) => {
          const phone = p.phone ?? config.phoneNumber;
          return (
            <div class="rounded-box border border-granite/15 bg-white p-6 md:p-8 flex flex-col gap-6">
              <div>
                <h2 class="heading-3 text-granite">
                  <a href={`/${locale}/${p.slug}`} class="hover:text-forest">
                    {p.name[locale]}
                  </a>
                </h2>
                <p class="mt-1 text-muted">{p.location[locale]}</p>
              </div>
              <div class="flex flex-col gap-3">
                <a href={whatsappHref(p.whatsappMessage[locale])} target="_blank" rel="noopener" class="btn-primary w-full">
                  <Icon name="whatsapp" size={18} />
                  {t("whatsappButton")}
                </a>
                <a href={telHref(phone)} class="btn-secondary w-full">
                  <Icon name="phone" size={16} strokeWidth={1.8} />
                  {t("callButton")} · {phone}
                </a>
              </div>
              {p.google?.url && (
                <a
                  href={p.google.url}
                  target="_blank"
                  rel="noopener"
                  class="mt-auto inline-flex items-center gap-1.5 text-sm text-muted hover:text-granite underline-offset-4 hover:underline"
                >
                  <Icon name="external" size={14} />
                  {t("googleProfile")}
                </a>
              )}
            </div>
          );
        })
      }
    </div>
  </section>

  <div class="border-t border-granite/10">
    <FAQ items={faq} locale={locale} />
  </div>
</BaseLayout>
