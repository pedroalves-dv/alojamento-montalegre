---
// Photo credits required by the Creative Commons licences of third-party photos.
// Linked only from the footer, and kept out of search results.
import { Picture } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { credits } from "@/data/credits";
import { localeParams, useTranslations, type Locale } from "@/i18n";
import { resolveImages, imageFormats } from "@/lib/images";

export const getStaticPaths = localeParams;

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale, "Creditos");
const thumbs = await resolveImages(credits.map((c) => c.image));
const link = "underline underline-offset-2 hover:text-forest";
---

<BaseLayout locale={locale} title={t("heading")} description={t("intro")} path="/creditos" ogImage="home" noindex>
  <section class="container-site pt-12 md:pt-20 pb-16 md:pb-24 max-w-3xl">
    <h1 class="heading-1 text-granite">{t("heading")}</h1>
    <p class="mt-4 text-body leading-relaxed">{t("intro")}</p>

    <ul class="mt-10 divide-y divide-granite/10 border-y border-granite/10">
      {
        credits.map((c, i) => (
          <li class="flex gap-4 py-5 items-start">
            <Picture
              src={thumbs[i]!}
              alt=""
              formats={imageFormats}
              widths={[96, 192]}
              sizes="96px"
              class="size-24 shrink-0 rounded-box object-cover"
            />
            <div class="text-sm leading-relaxed">
              <p class="font-medium text-granite text-base">{c.subject[locale]}</p>
              <p class="text-body">
                {t("by")}{" "}
                <a href={c.sourceUrl} target="_blank" rel="noopener" class={link}>{c.author}</a>
                {" · "}
                <a href={c.licenseUrl} target="_blank" rel="noopener" class={link}>{c.license}</a>
              </p>
              {c.changes && <p class="text-muted">{c.changes[locale]}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
