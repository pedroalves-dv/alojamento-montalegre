---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  locale="pt"
  title="Página não encontrada · Page not found"
  description="Esta página não existe. This page doesn't exist."
  path=""
  ogImage="home"
  noindex
>
  <section class="min-h-[60svh] flex items-center justify-center px-6 py-24 text-center">
    <div class="max-w-xl">
      <p class="font-serif text-8xl text-forest mb-4">404</p>
      <h1 class="font-serif text-4xl text-granite mb-2">Página não encontrada</h1>
      <p class="text-muted mb-1">A página que procura não existe ou foi movida.</p>
      <p class="text-muted mb-10" lang="en">The page you're looking for doesn't exist or has moved.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/pt" class="btn-primary">Início</a>
        <a href="/en" lang="en" class="btn-secondary">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
