---
import { config } from "@/config";
import { properties } from "@/data/properties";
import { useTranslations, type Locale } from "@/i18n";
import { telHref, whatsappHref } from "@/lib/links";
import Logo from "@/components/ui/Logo.astro";
import LocaleToggle from "@/components/ui/LocaleToggle.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale, "Footer");
const home = `/${locale}`;
const year = new Date().getFullYear();

const linkClass = "text-sm text-fog/75 hover:text-fog transition-colors";
const headingClass = "text-xs font-semibold tracking-widest uppercase text-fog/45 mb-1";

const reviewLinks = properties.flatMap((p) => [
  ...(p.booking.url ? [{ href: p.booking.url, name: p.name[locale], site: t("bookingLabel"), brand: "booking" as const }] : []),
  ...(p.google?.url ? [{ href: p.google.url, name: p.name[locale], site: t("googleLabel"), brand: "google" as const }] : []),
]);
const licences = properties.filter((p) => p.licenseNumber);
---

<footer id="site-footer" class="bg-granite text-fog" data-print-hidden>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
    <div class="flex flex-col gap-4">
      <a href={home} aria-label={t("inicio")}>
        <Logo variant="light" class="h-9" loading="lazy" />
      </a>
      <p class="text-fog/75 text-sm leading-relaxed max-w-xs">{t("tagline")}</p>
      <LocaleToggle locale={locale} class="text-fog mt-4" />
    </div>

    <nav class="flex flex-col gap-3" aria-labelledby="footer-nav-heading">
      <p id="footer-nav-heading" class={headingClass}>{t("navHeading")}</p>
      <a href={home} class={linkClass}>{t("inicio")}</a>
      <a href={`${home}#casas`} class={linkClass}>{t("casas")}</a>
      {
        properties.map((p) => (
          <a href={`${home}/${p.slug}`} class:list={[linkClass, "flex items-center gap-2 pl-3"]}>
            <Icon name="home" size={14} />
            {p.name[locale]}
          </a>
        ))
      }
      <a href={`${home}/regiao`} class={linkClass}>{t("regiao")}</a>
      <a href={`${home}/contacto`} class={linkClass}>{t("contacto")}</a>
    </nav>

    <div class="flex flex-col gap-3">
      <p class={headingClass}>{t("contactHeading")}</p>
      <a href={telHref()} class:list={[linkClass, "flex items-center gap-2"]}>
        <Icon name="phone" size={14} />
        {config.phoneNumber}
      </a>
      <a href={whatsappHref()} target="_blank" rel="noopener" class:list={[linkClass, "flex items-center gap-2"]}>
        <Icon name="whatsapp" size={14} />
        {t("whatsappLabel")}
      </a>
      <p class:list={[headingClass, "mt-4"]}>{t("reviewsHeading")}</p>
      <div class="flex flex-col gap-2">
        {
          reviewLinks.map(({ href, name, site, brand }) => (
            <a href={href} target="_blank" rel="noopener" class:list={[linkClass, "flex items-center gap-2"]}>
              <span
                class:list={[
                  "inline-flex size-3.5 items-center justify-center rounded-[3px] text-[8px] font-bold text-white",
                  brand === "booking" ? "bg-booking" : "bg-google",
                ]}
                aria-hidden="true"
              >
                {brand === "booking" ? "b." : "G"}
              </span>
              {name}
              <span class="sr-only"> — {site}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 flex flex-col gap-4 text-xs leading-relaxed text-fog/75">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-x-8 gap-y-3">
        <p class="whitespace-nowrap">{t("copyright", { year })}</p>
        {
          licences.length > 0 && (
            <ul class="flex flex-col sm:flex-row gap-x-6 gap-y-1">
              {licences.map((p) => (
                <li class="whitespace-nowrap">
                  {p.name[locale]} <span class="ml-1 tabular-nums text-fog/90">{p.licenseNumber}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-x-8 gap-y-3 text-fog/60">
        <p class="max-w-prose">{t("cookieNotice")}</p>
        <a
          href={`/${locale}/creditos`}
          class="inline-flex items-center gap-1.5 whitespace-nowrap text-fog/75 hover:text-fog transition-colors"
        >
          {t("creditsLink")}
          <Icon name="arrow-right" size={12} />
        </a>
      </div>
    </div>
  </div>
</footer>
