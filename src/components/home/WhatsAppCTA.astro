---
// Final call-to-action — one of the two centred blocks on the site (with the hero).
import { config } from "@/config";
import { useTranslations, type Locale } from "@/i18n";
import { telHref, whatsappHref } from "@/lib/links";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale, "Home");
---

<section class="bg-forest text-white">
  <div class="container-site section-y max-w-2xl text-center">
    <h2 class="heading-2 mb-4">{t("whatsappHeading")}</h2>
    <p class="text-white/85 leading-relaxed mb-9 text-balance">{t("whatsappBody")}</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center [&>*]:w-full sm:[&>*]:w-auto">
      <a href={whatsappHref()} target="_blank" rel="noopener" class="btn-light">
        <Icon name="whatsapp" size={18} />
        {t("whatsappButton")}
      </a>
      <a href={telHref()} class="btn-outline-light">
        <Icon name="phone" size={16} strokeWidth={1.8} />
        {config.phoneNumber}
      </a>
    </div>
  </div>
</section>
