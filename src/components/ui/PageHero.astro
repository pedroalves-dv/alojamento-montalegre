---
// Hero used by the home and region pages: one photo, kept to the site's
// content width, with a centred headline, one line of copy and optional
// buttons (stacked full-width on mobile, inline from `sm` up).
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { imageFormats } from "@/lib/images";

interface Props {
  image: ImageMetadata;
  alt: string;
  headline: string;
  text: string;
}

const { image, alt, headline, text } = Astro.props;
const widths = [640, 960, 1280, 1600, 2000].filter((w) => w < image.width).concat(image.width);
const shadow = "[text-shadow:0_1px_12px_rgba(0,0,0,0.45)]";
---

<section class="container-site pt-6 md:pt-8">
  <div
    class="relative isolate overflow-hidden rounded-box bg-granite flex items-center justify-center h-[min(72svh,600px)] md:h-[min(78svh,760px)] min-h-[420px]"
  >
    <Picture
      src={image}
      alt={alt}
      formats={imageFormats}
      widths={widths}
      sizes="(min-width: 1152px) 1104px, calc(100vw - 2rem)"
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: "absolute inset-0 -z-10" }}
      class="size-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-[rgba(20,24,20,0.6)]"
    >
    </div>

    <div class="w-full max-w-3xl px-6 text-center text-white">
      <h1 class:list={["heading-1", shadow]}>{headline}</h1>
      <p class:list={["mt-5 text-lg md:text-xl text-white/95 text-balance", shadow]}>{text}</p>
      {
        Astro.slots.has("default") && (
          <div class="mt-9 flex flex-col sm:flex-row gap-3 sm:justify-center [&>*]:w-full sm:[&>*]:w-auto">
            <slot />
          </div>
        )
      }
    </div>
  </div>
</section>
