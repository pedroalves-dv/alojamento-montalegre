---
import { locales, switchLocalePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  class?: string;
  /** "lg" for the mobile menu; the default suits the navbar and footer. */
  size?: "sm" | "lg";
}

const { locale, class: className, size = "sm" } = Astro.props;
const labels: Record<Locale, string> = { pt: "Português", en: "English" };
---

<div
  class:list={[
    "flex items-center font-semibold tracking-widest",
    size === "lg" ? "gap-2.5 text-base" : "gap-1.5 text-xs",
    className,
  ]}
>
  {
    locales.map((l, i) => (
      <>
        {i > 0 && (
          <span class="opacity-30 select-none" aria-hidden="true">
            |
          </span>
        )}
        {l === locale ? (
          <span aria-current="true">{l.toUpperCase()}</span>
        ) : (
          <a
            href={switchLocalePath(Astro.url.pathname, l)}
            hreflang={l}
            lang={l}
            aria-label={`${l.toUpperCase()} — ${labels[l]}`}
            class="relative opacity-70 hover:opacity-100 transition-opacity after:absolute after:-inset-3.5 after:content-['']"
          >
            {l.toUpperCase()}
          </a>
        )}
      </>
    ))
  }
</div>
