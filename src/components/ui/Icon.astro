---
// One entry point for every icon on the site. All icons are Lucide
// (https://lucide.dev, rendered at build time, no JS) except the WhatsApp
// brand mark. Add a new icon by importing it below and adding it to `icons`.
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Bath from "@lucide/astro/icons/bath";
import BedDouble from "@lucide/astro/icons/bed-double";
import CarFront from "@lucide/astro/icons/car-front";
import Check from "@lucide/astro/icons/check";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Clock from "@lucide/astro/icons/clock";
import Euro from "@lucide/astro/icons/euro";
import ExternalLink from "@lucide/astro/icons/external-link";
import Footprints from "@lucide/astro/icons/footprints";
import HandHeart from "@lucide/astro/icons/hand-heart";
import House from "@lucide/astro/icons/house";
import LayoutGrid from "@lucide/astro/icons/layout-grid";
import MapPin from "@lucide/astro/icons/map-pin";
import Menu from "@lucide/astro/icons/menu";
import Phone from "@lucide/astro/icons/phone";
import Route from "@lucide/astro/icons/route";
import Ruler from "@lucide/astro/icons/ruler";
import Star from "@lucide/astro/icons/star";
import SunSnow from "@lucide/astro/icons/sun-snow";
import TentTree from "@lucide/astro/icons/tent-tree";
import Users from "@lucide/astro/icons/users";
import Waves from "@lucide/astro/icons/waves-horizontal";
import X from "@lucide/astro/icons/x";

const icons = {
  // UI
  "arrow-right": ArrowRight,
  "chevron-down": ChevronDown,
  "chevron-left": ChevronLeft,
  "chevron-right": ChevronRight,
  close: X,
  menu: Menu,
  external: ExternalLink,
  grid: LayoutGrid,
  check: Check,
  clock: Clock,
  star: Star,
  // Contact & places
  phone: Phone,
  "map-pin": MapPin,
  car: CarFront,
  // Property facts
  users: Users,
  home: House,
  bed: BedDouble,
  bath: Bath,
  sqm: Ruler,
  price: Euro,
  // Region — "Selvagem por natureza"
  route: Route,
  waves: Waves,
  adventure: TentTree,
  hiking: Footprints,
  seasons: SunSnow,
  hospitality: HandHeart,
};

export type IconName = keyof typeof icons | "whatsapp";

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  filled?: boolean;
  class?: string;
  label?: string;
}

const { name, size = 16, strokeWidth = 2, filled, class: className, label } = Astro.props;
const a11y = label ? { "aria-label": label, role: "img" as const } : { "aria-hidden": "true" as const };
const LucideIcon = name === "whatsapp" ? null : icons[name];
---

{
  LucideIcon ? (
    <LucideIcon
      size={size}
      stroke-width={strokeWidth}
      fill={filled ? "currentColor" : "none"}
      class:list={["shrink-0", className]}
      {...a11y}
    />
  ) : (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class:list={["shrink-0", className]} {...a11y}>
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
    </svg>
  )
}
