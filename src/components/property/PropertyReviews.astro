---
import type { PropertyReviewsConfig, ReviewPlatform } from "@/types/property";
import type { Locale } from "@/i18n";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  reviews: PropertyReviewsConfig;
  locale: Locale;
  heading: string;
  allReviewsLabel: string;
}

const { reviews, locale, heading, allReviewsLabel } = Astro.props;

const platformColors: Record<ReviewPlatform, string> = {
  Google: "bg-google text-white",
  "Booking.com": "bg-booking text-white",
  TripAdvisor: "bg-[#34E0A1] text-granite",
  Airbnb: "bg-[#FF5A5F] text-white",
};
// Privacy: show first name + last-name initial only ("Maria Silva" → "Maria S.")
function privateName(name: string) {
  const parts = name.trim().split(/\s+/);
  if (parts.length < 2) return parts[0] ?? "";
  const last = parts.at(-1)!;
  return /^\p{L}\.$/u.test(last) ? parts.join(" ") : `${parts[0]} ${last[0]!.toUpperCase()}.`;
}
const starsLabel = (n: number) => (locale === "pt" ? `${n} de 5 estrelas` : `${n} out of 5 stars`);
---

{
  reviews.items.length > 0 && (
    <section class="py-12 md:py-14 border-t border-granite/10" data-print-hidden>
      <h2 class="heading-2 text-granite mb-8">{heading}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {reviews.items.map((review) => (
          <figure class="flex flex-col gap-4 rounded-box border border-granite/15 bg-white p-6">
            <div class="flex gap-0.5" role="img" aria-label={starsLabel(review.rating)}>
              {Array.from({ length: 5 }, (_, s) => (
                <Icon
                  name="star"
                  size={14}
                  strokeWidth={1.5}
                  filled={s < review.rating}
                  class={s < review.rating ? "text-amber" : "text-granite/20"}
                />
              ))}
            </div>
            <blockquote class="text-body leading-relaxed flex-1">
              &ldquo;{review.text[locale]}&rdquo;
            </blockquote>
            <figcaption class="flex items-center justify-between gap-3 mt-auto">
              <span class="text-sm text-muted">
                — {privateName(review.author)}
                {review.country && `, ${review.country[locale]}`}
              </span>
              <span
                class:list={["text-[0.65rem] font-semibold px-2 py-0.5 rounded-full tracking-wide", platformColors[review.platform]]}
              >
                {review.platform}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
      {reviews.allReviewsUrl && (
        <a href={reviews.allReviewsUrl} target="_blank" rel="noopener" class="btn-secondary mt-8">
          {allReviewsLabel}
        </a>
      )}
    </section>
  )
}
