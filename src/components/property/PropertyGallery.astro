---
// Property photos: a native swipe strip (CSS scroll-snap) on mobile and a
// 1 large + 4 small grid on desktop — the same markup restyled per breakpoint.
// Tapping any photo opens the fullscreen lightbox.
import type { ImageMetadata } from "astro";
import { Picture, getImage } from "astro:assets";
import { useTranslations, type Locale } from "@/i18n";
import { imageFormats } from "@/lib/images";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  images: ImageMetadata[];
  name: string;
  locale: Locale;
  class?: string;
}

const { images, name, locale, class: className } = Astro.props;
const t = useTranslations(locale, "PropertyDetail");
const viewAll = t("galleryViewAll", { count: images.length });

const lightboxSources = await Promise.all(
  images.map(async (src) => (await getImage({ src, width: Math.min(src.width, 1800), format: "webp" })).src),
);
const widthsFor = (src: ImageMetadata) => [480, 720, 960, 1280, 1600].filter((w) => w < src.width).concat(src.width);
---

<property-gallery data-sources={JSON.stringify(lightboxSources)} class:list={["relative block", className]} data-print-hidden>
  <div
    class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain rounded-box [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:grid md:grid-cols-4 md:grid-rows-2 md:gap-2 md:h-[min(60svh,540px)] md:overflow-hidden"
    data-track
  >
    {
      images.map((src, i) => (
        <button
          type="button"
          class:list={[
            "relative w-full shrink-0 snap-center aspect-[4/3] overflow-hidden bg-granite/5 md:aspect-auto md:h-full cursor-zoom-in",
            i === 0 && "md:col-span-2 md:row-span-2",
            i > 4 && "md:hidden",
          ]}
          aria-label={`${viewAll} — ${i + 1} / ${images.length}`}
          data-open={i}
        >
          <Picture
            src={src}
            alt={i === 0 ? name : ""}
            formats={imageFormats}
            widths={widthsFor(src)}
            sizes={i === 0 ? "(min-width: 768px) 560px, calc(100vw - 2rem)" : "(min-width: 768px) 280px, calc(100vw - 2rem)"}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
            class="size-full object-cover transition-[filter] duration-200 hover:brightness-90"
          />
        </button>
      ))
    }
  </div>

  <!-- Mobile: position counter. Desktop: "view all" -->
  <span
    class="md:hidden pointer-events-none absolute bottom-3 right-3 rounded-full bg-black/55 px-3 py-1 text-xs font-medium tabular-nums text-white"
    aria-hidden="true"
    data-counter>1 / {images.length}</span
  >
  <div class="hidden md:block absolute bottom-4 right-4">
    <button type="button" class="btn-light px-4 py-2 text-sm shadow-sm" data-open="0">
      <Icon name="grid" />
      {viewAll}
    </button>
  </div>

  <dialog
    class="m-0 p-0 w-full max-w-none h-dvh max-h-none bg-granite/95 text-white open:flex items-center justify-center"
    aria-label={name}
    data-lightbox
  >
    <img alt="" class="max-w-[calc(100%-1.5rem)] md:max-w-[min(72rem,calc(100%-8rem))] max-h-[82vh] object-contain" data-lightbox-img />
    <button type="button" class="absolute top-3 right-3 rounded-full p-2.5 text-white/80 hover:bg-white/10 hover:text-white" aria-label={t("galleryClose")} data-close>
      <Icon name="close" size={24} />
    </button>
    <button type="button" class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 rounded-full p-2.5 text-white/80 hover:bg-white/10 hover:text-white" aria-label={t("galleryPrev")} data-lb-prev>
      <Icon name="chevron-left" size={30} strokeWidth={1.5} />
    </button>
    <button type="button" class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 rounded-full p-2.5 text-white/80 hover:bg-white/10 hover:text-white" aria-label={t("galleryNext")} data-lb-next>
      <Icon name="chevron-right" size={30} strokeWidth={1.5} />
    </button>
    <p class="absolute bottom-5 left-1/2 -translate-x-1/2 text-white/70 text-sm tabular-nums" data-lb-counter></p>
  </dialog>
</property-gallery>

<script>
  class PropertyGallery extends HTMLElement {
    #index = 0;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>("[data-track]")!;
      const counter = this.querySelector<HTMLElement>("[data-counter]")!;
      const sources: string[] = JSON.parse(this.dataset.sources!);
      const dialog = this.querySelector<HTMLDialogElement>("[data-lightbox]")!;
      const img = this.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
      const lbCounter = this.querySelector<HTMLElement>("[data-lb-counter]")!;
      const total = sources.length;
      const wrap = (n: number) => ((n % total) + total) % total;

      // Mobile strip: keep the "n / total" counter in sync with the swipe position
      track.addEventListener(
        "scroll",
        () => {
          const n = Math.round(track.scrollLeft / track.clientWidth);
          counter.textContent = `${n + 1} / ${total}`;
        },
        { passive: true },
      );

      const show = (n: number) => {
        this.#index = wrap(n);
        img.src = sources[this.#index]!;
        lbCounter.textContent = `${this.#index + 1} / ${total}`;
        new Image().src = sources[wrap(this.#index + 1)]!; // warm the next one
      };

      this.querySelectorAll<HTMLElement>("[data-open]").forEach((el) =>
        el.addEventListener("click", () => {
          show(Number(el.dataset.open));
          dialog.showModal();
        }),
      );
      this.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
      this.querySelector("[data-lb-prev]")!.addEventListener("click", () => show(this.#index - 1));
      this.querySelector("[data-lb-next]")!.addEventListener("click", () => show(this.#index + 1));
      dialog.addEventListener("click", (e) => e.target === dialog && dialog.close());
      dialog.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(this.#index - 1);
        if (e.key === "ArrowRight") show(this.#index + 1);
      });

      // Swipe inside the lightbox
      let x = 0;
      dialog.addEventListener("touchstart", (e) => (x = e.touches[0]!.clientX), { passive: true });
      dialog.addEventListener("touchend", (e) => {
        const dx = e.changedTouches[0]!.clientX - x;
        if (Math.abs(dx) > 40) show(this.#index + (dx < 0 ? 1 : -1));
      });
    }
  }

  customElements.define("property-gallery", PropertyGallery);
</script>
