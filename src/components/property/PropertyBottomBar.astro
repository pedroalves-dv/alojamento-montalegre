---
// Mobile-only sticky booking bar: price on the left and, on the right, a jump
// to the availability form (the Airbnb/Booking pattern) or a call button for
// phone-only houses. Slides away while the booking section or footer is visible.
import { telHref } from "@/lib/links";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  /** In-page link to the availability form; null for phone-only houses. */
  requestHref: string | null;
  phone: string;
  callLabel: string;
  fromLabel: string;
  perNight: string | null;
  ctaLabel: string;
}

const { requestHref, phone, callLabel, fromLabel, perNight, ctaLabel } = Astro.props;
---

<div
  id="property-bottom-bar"
  class="md:hidden fixed bottom-0 inset-x-0 z-30 border-t border-granite/15 bg-white/95 backdrop-blur-sm px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] flex items-center justify-between gap-4 transition-transform duration-300 data-[hidden]:translate-y-full"
  data-print-hidden
>
  {
    perNight ? (
      <p class="text-xs text-muted leading-tight">
        {fromLabel}
        <span class="block whitespace-nowrap text-base font-semibold text-granite">{perNight}</span>
      </p>
    ) : (
      <a href={telHref(phone)} class="text-sm font-medium text-granite">
        {phone}
      </a>
    )
  }
  {
    requestHref ? (
      <a href={requestHref} class="btn-primary shrink-0 whitespace-nowrap px-5 py-2.5 text-sm">
        <Icon name="whatsapp" size={16} />
        {ctaLabel}
      </a>
    ) : (
      <a href={telHref(phone)} class="btn-primary shrink-0 whitespace-nowrap px-5 py-2.5 text-sm">
        <Icon name="phone" size={16} strokeWidth={1.8} />
        {callLabel}
      </a>
    )
  }
</div>

<script>
  const bar = document.getElementById("property-bottom-bar")!;
  const targets = ["reservar", "site-footer"].flatMap((id) => document.getElementById(id) ?? []);
  const visible = new Set<Element>();
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target);
    bar.toggleAttribute("data-hidden", visible.size > 0);
  });
  targets.forEach((el) => observer.observe(el));
</script>
